PROFILE_NAME="Lean MT7621 CI Smoke"
SOURCE_REPO="https://github.com/coolsnowwolf/lede"
SOURCE_BRANCH="master"
ADAPTER="direct-openwrt"

CONFIG_FILE="profiles/smoke/.config"
DIY_PART1="profiles/smoke/diy-part1.sh"
DIY_PART2="profiles/smoke/diy-part2.sh"
REQUIRED_PACKAGES_FILE="profiles/smoke/required-packages.txt"
WATCH_SOURCES_FILE="profiles/smoke/watch-sources.txt"

AUTO_UPDATE="false"
MAXIMIZE_BUILD_SPACE="false"
STREAM_BUILD_LOG="true"

UPLOAD_BIN_DIR="false"
UPLOAD_FIRMWARE="true"
UPLOAD_RELEASE="true"
